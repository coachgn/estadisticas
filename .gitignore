.claude/settings.local.json

# El symlink que `npx skills add` crea para Claude Code apunta a una ruta
# absoluta de esta máquina: se regenera solo con el mismo comando (punto 14).
# La skill EN SÍ sí va al repo, en .agents/skills/.
.claude/skills/
# Taste trae 37 MB de fotos de referencia: el repo es público y lo sirve
# Pages. Queda solo local; se reinstala con npx skills add Leonxlnx/taste-skill.
.agents/skills/design-taste-frontend/

# Backend (PoC)
server/.env
server/node_modules/

# Centro de Mando local: la clave de la API de Claude y sus dependencias.
centro-mando/.env
centro-mando/node_modules/

# Los informes de referencia del plan ORO: material de trabajo, no codigo.
# Son 7 MB de PDF y no los necesita el sitio.
COMPARATIVAS EJEMPLOS/

.vercel

# Salida de generar-contenido.js: numeros y nombres para redes. No se publica.
contenido/
centro-mando/.canva-token.json

# Equipo de marketing (estrategia privada: el repo es publico)
.claude/agents/
.claude/commands/equipo.md

# La clave del feed de la agenda no va al repositorio.
agenda-script/Config.js
agenda-script/.clasp.json
agenda-script/pegar-en-motorstats.js

# Material de reels: video, PNG y entregables (71 MB). No va al repo.
reels/
