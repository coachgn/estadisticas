.claude/settings.local.json

# El symlink que `npx skills add` crea para Claude Code apunta a una ruta
# absoluta de esta máquina: se regenera solo con el mismo comando (punto 14).
# La skill EN SÍ sí va al repo, en .agents/skills/.
.claude/skills/

# Backend (PoC)
server/.env
server/node_modules/

# Centro de Mando local: la clave de la API de Claude y sus dependencias.
centro-mando/.env
centro-mando/node_modules/

# Los informes de referencia del plan ORO: material de trabajo, no codigo.
# Son 7 MB de PDF y no los necesita el sitio.
COMPARATIVAS EJEMPLOS/

.vercel

# Salida de generar-contenido.js: numeros y nombres para redes. No se publica.
contenido/
centro-mando/.canva-token.json
