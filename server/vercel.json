{
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "Vary", "value": "Origin, Authorization" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/recordatorios-vencimiento", "schedule": "0 12 * * *" },
    { "path": "/api/cron/predicciones", "schedule": "0 11 * * *" }
  ]
}
