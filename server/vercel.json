{
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "Vary", "value": "Origin, Authorization" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/recordatorios-vencimiento", "schedule": "0 12 * * *" },
    { "path": "/api/cron/alertas-partidos", "schedule": "0 10 * * *" },
    { "path": "/api/cron/carga-manual?flujo=previa", "schedule": "0 15 * * *" },
    { "path": "/api/cron/carga-manual?flujo=control", "schedule": "0 10 * * *" }
  ]
}
