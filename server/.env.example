# =====================================================================
# SGADD · variables del backend
#
# Copiar a `server/.env` y completar. El `.env` está en .gitignore:
# NUNCA se commitea, y si alguna vez se sube por error hay que rotar
# la clave de la Service Account y el JWT_SECRET, no solo borrar el
# archivo — el historial de git lo conserva.
#
# En Vercel estas mismas variables van en Settings → Environment
# Variables, y ahí `GOOGLE_PRIVATE_KEY` se pega con los `\n` literales
# tal cual salen del JSON de la cuenta.
# =====================================================================

# --- Google Service Account (ver server/README.md) -------------------
# El mail que figura como `client_email` en el JSON que descarga Google.
# Es el que hay que compartir en las planillas, en modo LECTOR.
GOOGLE_SERVICE_ACCOUNT_EMAIL=sgadd-lector@mi-proyecto.iam.gserviceaccount.com

# El `private_key` del mismo JSON, ENTERO y entre comillas, con los
# `\n` tal cual vienen. Si se pegan saltos de línea reales, el `.env`
# se corta en la primera línea y la firma falla con un error de OpenSSL
# que no menciona el problema.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# --- Firma de los tokens de acceso -----------------------------------
# Mínimo 32 caracteres. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotarlo invalida TODOS los links de cliente emitidos.
JWT_SECRET=

# --- Los sheetId, que dejan de estar en clubes/*.json ----------------
# Este es el punto entero del backend: acá viven y no salen nunca en una
# respuesta. El frontend pasa a conocer solo los slugs.
# La clave es el SLUG que declara clubes/<club>.json, no el id de Google.
SHEET_DEPORTIVO_PRIMERA=
SHEET_RECONQUISTA_PRIMERA=
# OJO: el JSON publico traia para la U21 un id que devuelve 401 y que el
# archivo real no tiene. El bueno arranca con 1wNpSkd. Ver el punto 10.1
# de docs/ARQUITECTURA-BACKEND.md.
SHEET_RECONQUISTA_U21=
SHEET_RECONQUISTA_U23=
SHEET_JUJUY_PRIMERA=

# --- Upstash KV · el catalogo de clubes ------------------------------
# OPCIONAL. Sin esto el catalogo sale de SGADD_CATALOGO o, si tampoco
# esta, del literal de server/lib/config.js. El servidor NUNCA se cae
# por no tener KV: la cascada baja sola.
#
# Con KV, dar de alta un club es un comando y NO pide redeploy:
#   node server/bin/catalogo.js alta --club X --categoria Y --sheet <id>
#
# Los nombres KV_REST_API_* son los que inyecta la integracion de Vercel;
# los UPSTASH_* los que da el panel de Upstash. Sirven los dos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: si se configura, el SERVIDOR usa este y el CLI el de arriba.
# Menos superficie: la funcion desplegada no necesita poder escribir.
KV_REST_API_READ_ONLY_TOKEN=

# --- El catalogo como variable, sin Upstash --------------------------
# El escalon intermedio de la cascada. Es un JSON con la misma forma que
# el literal de config.js; se obtiene con:
#   node server/bin/catalogo.js exportar
# OJO: trae los sheetId en claro, o sea que es un secreto.
# Cambiarlo SI pide redeploy — para eso esta KV.
SGADD_CATALOGO=

# --- CORS ------------------------------------------------------------
# Lista separada por comas. NUNCA `*`: con comodín, cualquier página
# podría hacer que el navegador de un cliente pida sus datos.
# Vacío = no se acepta ningún origen de navegador.
ORIGENES_PERMITIDOS=https://coachgn.github.io,http://localhost:8765

# --- Opcionales ------------------------------------------------------
PORT=3000
RATE_LIMIT_MAX=60
RATE_LIMIT_VENTANA_MS=60000
# Techo del dato viejo servido desde el caché en memoria.
TTL_CACHE_MS=300000
